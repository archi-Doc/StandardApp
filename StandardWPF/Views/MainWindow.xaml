<Window x:Class="StandardWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StandardWPF.Views"
        xmlns:Arc="clr-namespace:Arc.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="412" Width="525"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing" KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/skin.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="100" x:Name="LeftGrid"/>
            <ColumnDefinition Width="1*" MinWidth="100" x:Name="RightGrid"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="5" Background="#FFB0B0B0" />

        <Grid ShowGridLines="False" Grid.Row="0" Grid.Column="0" >
            <StackPanel Margin="4">
                <TextBlock x:Name="textBlock" HorizontalAlignment="Left" Height="Auto" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="106" Margin="4"/>
                <TextBox x:Name="textBox" HorizontalAlignment="Left" Height="30" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="126" Margin="4"/>
                <TextBlock x:Name="textBlock1" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Height="20" Width="178" Text="{Arc:Format {Arc:StringerBinding TimeText}, {Binding CreatedTime}}" Margin="4"></TextBlock>
                <Button x:Name="button_disable" Content="disable/enable" HorizontalAlignment="Left" Height="auto" VerticalAlignment="Top" Width="auto" Command="{Binding ToggleEnabledStateCommand}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="textBox2" HorizontalAlignment="Left" Height="18" Margin ="4" TextWrapping="Wrap" Text="{Binding Addend1}" VerticalAlignment="Top" Width="55"/>
                    <TextBox x:Name="textBox3" HorizontalAlignment="Left" Height="18" Margin ="4" TextWrapping="Wrap" Text="{Binding Addend2}" VerticalAlignment="Top" Width="55"/>
                    <TextBox x:Name="textBox4" HorizontalAlignment="Left" Height="18" Margin ="4" TextWrapping="Wrap" Text="{Binding SumValue}" VerticalAlignment="Top" Width="55" IsEnabled="False"/>
                </StackPanel>

                <TextBox x:Name="textBox5" HorizontalAlignment="Left" Height="18" Margin="4" TextWrapping="Wrap" Text="{Binding ToggleCountValue}" VerticalAlignment="Top" Width="55" IsEnabled="False"/>

                <Arc:DragDropListView Height="150" Margin="4" x:Name="listView" ItemsSource="{Binding TestItems.ObservableChain}" SelectionChanged="ListView_SelectionChanged">
                    <Arc:DragDropListView.View>
                        <GridView>
                            <GridViewColumn DisplayMemberBinding="{Binding IdValue}" Width="50" >
                                <GridViewColumnHeader Content="{Arc:Stringer ListView.Header.Id}"/>
                            </GridViewColumn>
                            <GridViewColumn DisplayMemberBinding="{Binding DateTimeValue, Converter={StaticResource DateTimeToStringConverter}}" Width="150" >
                                <GridViewColumnHeader Content="{Arc:Stringer ListView.Header.Time}"/>
                            </GridViewColumn>
                        </GridView>
                    </Arc:DragDropListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Arc:Stringer ListView.Menu.Increment}" Command="{Binding IncrementSelectedIdCommand}" ToolTip="{Arc:Stringer listview.menu.increment.tt}"/>
                            <Separator />
                            <MenuItem Header="{Arc:Stringer ListView.Menu.Decrement}" Command="{Binding DecrementSelectedIdCommand}" ToolTip="{Arc:Stringer listview.menu.increment.tt}" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                </Arc:DragDropListView>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="button8" Content="{Arc:Stringer Button.AddItem}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="auto" Height="auto" Command="{Binding AddItemCommand}" />
                    <Button x:Name="button9" Content="{Arc:Stringer Button.ClearItem}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="auto" Height="auto" Command="{Binding ClearItemsCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid ShowGridLines="False" Grid.Row="0" Grid.Column="1" >
            <StackPanel>
                <Button x:Name="button" Content="{Arc:Stringer Button.Text}" HorizontalAlignment="Left" Height="auto"  VerticalAlignment="Top" Width="auto" Command="{Binding ToggleBrushColorCommand}" ToolTip="{Arc:Stringer tooltip.button}"  Background="Aqua" />
                <Button x:Name="button1" Content="switch language" HorizontalAlignment="Left" Height="auto" VerticalAlignment="Top" Width="auto" Command="{Binding SendMessageIdCommand}" CommandParameter="SwitchCulture"  Background="{Binding Options.BrushCollection.Brush1.Brush}" />
                <Button x:Name="button2" Content="dialog test" HorizontalAlignment="Left" VerticalAlignment="Top" Width="auto" Height="auto" Command="{Binding ShowDescriptionDialogCommand}" Visibility="{Binding HideDialogButtonValue, ConverterParameter=Inverted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button x:Name="button6" Content="dialog test2" HorizontalAlignment="Left" VerticalAlignment="Top" Width="auto" Height="auto" Command="{Binding ShowYesNoDialogCommand}" Visibility="{Binding HideDialogButtonValue, ConverterParameter=Inverted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button x:Name="button7" Content="dialog test3" HorizontalAlignment="Left" VerticalAlignment="Top" Width="auto" Height="auto" Command="{Binding ShowCustomDialogCommand}" Visibility="{Binding HideDialogButtonValue, ConverterParameter=Inverted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button x:Name="button3" Content="task" HorizontalAlignment="Left" Height="auto" VerticalAlignment="Top" Width="auto" Command="{Binding ExitWithoutConfirmationCommand}"/>
                <Button x:Name="button4" Content="info" HorizontalAlignment="Left" Height="auto" VerticalAlignment="Top" Width="auto" Command="{Binding SendMessageIdCommand}" CommandParameter="Information"/>
                <Button x:Name="buttonSettings" Content="{Arc:Stringer Button.Settings}"  HorizontalAlignment="Left" Height="auto" VerticalAlignment="Top" Width="auto"  Command="{Binding SendMessageIdCommand}" CommandParameter="Settings" />
                <Button x:Name="buttonDataFolder" Content="{Arc:Stringer Button.DataFolder}"  HorizontalAlignment="Left" Height="auto" VerticalAlignment="Top" Width="auto"  Command="{Binding SendMessageIdCommand}" CommandParameter="DataFolder" />
                <Button x:Name="buttonCrossChannel" Content="CrossChannel"  HorizontalAlignment="Left" Height="auto" VerticalAlignment="Top" Width="auto"  Command="{Binding TestCrossChannelCommand}"/>
                <Button x:Name="buttonCrossChannel2" Content="CrossChannel2"  HorizontalAlignment="Left" Height="auto" VerticalAlignment="Top" Width="auto"  Command="{Binding TestCrossChannel2Command}"/>
                <Button x:Name="button5" Content="exit without confirmation" HorizontalAlignment="Left" Height="auto"  VerticalAlignment="Top" Width="auto" Command="{Binding SendMessageIdCommand}" CommandParameter="ExitWithoutConfirmation"/>
            </StackPanel>


            <!--<MultiBinding StringFormat="{kid:Stringer time.text}">
            <Binding Path="CreatedTime" />
        </MultiBinding>-->
            <!--<MultiBinding StringFormat="Time is {0:MM/dd H:mm:ss}">
            <Binding Path="CreatedTime" />
        </MultiBinding>-->
            <!--Text="{Binding CreatedTime, StringFormat='{}{0:MM/dd H:mm:ss}'}"-->
        </Grid>

    </Grid>
</Window>
