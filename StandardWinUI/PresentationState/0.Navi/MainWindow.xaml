<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StandardWinUI.PresentationState.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StandardWinUI"
    xmlns:Arc="using:Arc.WinUI"
    xmlns:winex="using:WinUIEx"
    xmlns:control="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <control:LayoutTransformControl x:Name="layoutTransform">

        <NavigationView x:Name="navigationView" Background="WhiteSmoke" OpenPaneLength="180" PaneDisplayMode="Left" IsTabStop="False" SelectionChanged="nvSample_SelectionChanged" IsSettingsVisible="False" IsBackButtonVisible="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="nvHome" Icon="Home" Content="{Arc:Stringer Key=Navigation.Hello}" Tag="Home" />
                <NavigationViewItem x:Name="nvBaibain" Icon="Home" Content="{Arc:Stringer Key=Navigation.Baibain}" Tag="Baibain" />
                <NavigationViewItem x:Name="nvState" Icon="Home" Content="{Arc:Stringer Key=Navigation.State}" Tag="State" />
                <NavigationViewItem x:Name="nvMessage" Icon="Home" Content="{Arc:Stringer Key=Navigation.Message}" Tag="Message" />
                <NavigationViewItem x:Name="nvAdvanced" Icon="Home" Content="{Arc:Stringer Key=Navigation.Advanced}" Tag="Advanced" />
                <NavigationViewItem x:Name="nvSettings" Icon="Setting" Content="{Arc:Stringer Key=Navigation.Settings}" Tag="Settings" />
                <NavigationViewItem x:Name="nvInformation" Icon="ContactInfo" Content="{Arc:Stringer Key=Navigation.Information}" Tag="Information" />
                <NavigationViewItem x:Name="nvExit" Icon="Cancel" Content="{Arc:Stringer Key=Navigation.Exit}" Tag="Exit" Tapped="nvExit_Tapped"  SelectsOnInvoked="False"/>
            </NavigationView.MenuItems>
            <Frame x:Name="contentFrame"/>
        </NavigationView>

    </control:LayoutTransformControl>

</Window>
